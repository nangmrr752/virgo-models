# Copy to .env (git ignores it) and fill in. Never commit .env.
HF_TOKEN=hf_...            # Hugging Face token (read access to your Virgo models)
CF_TUNNEL_TOKEN=...        # your Cloudflare Tunnel token (the tunnel for virgo.camksn.com)
VIRGO_API_KEY=...          # the key the website uses
# Optional:
# SERVE_BAYON=0
# USE_VIRGO_VOICE=0
# VIRGO_DATA=/opt/virgo/docker
