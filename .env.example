# Copy to .env (git ignores it) and fill in. Never commit .env.
HF_TOKEN=hf_...            # Hugging Face token (read access to your Virgo models)
CF_TUNNEL_TOKEN=...        # your Cloudflare Tunnel token (the tunnel for virgo.camksn.com)
VIRGO_API_KEY=...          # the key the website uses
# Virgo's Hugging Face organization, where the models live (see MODELS.md)
VIRGO_HF_ORG=virgoai
# Optional:
# VIRGO_MAIN=bayon       # run Bayon-1.0 instead of Angkor (both don't fit one 24 GB GPU)
# SERVE_BAYON=0
# USE_VIRGO_VOICE=0
# VIRGO_DATA=/opt/virgo/docker
# HF_CACHE=/opt/virgo/hf-cache   # Hugging Face downloads shared with training
# VIRGO_LIVE_VERSION=2.0   # the live voice's name: Virgo-Bakong-2.0 (set the same on the website)
# Khmer fallback voice when Virgo's own voice (VoxCPM2) isn't running: Microsoft's Sreymom / Piseth.
# VIRGO_KHMER_VOICE=sreymom   # or piseth (default piseth with VIRGO_MAIN=bayon)
# VIRGO_ENGLISH_FALLBACK_VOICE=ava   # English fallback: ava / emma (women), andrew / brian (men); andrew with Bayon
# VIRGO_STT_KHMER_MODEL=virgoai/Angkor-1.0-STT  # Virgo's Khmer ear (found automatically when empty)
# VIRGO_STT_GENERAL_MODEL=openai/whisper-large-v3-turbo  # hearing for every language (off: Khmer model only)
# VIRGO_STT_LANGUAGES=all      # hearing: every language Whisper knows (~99), or a list like km,en
# VIRGO_STT_OTHER_MIN=0.8      # hearing: how sure it must be you spoke another language (else Khmer)
# Every other language uses its own default Microsoft voice (found automatically):
# VIRGO_VOICE_GENDER=female     # or male (default: male with Bayon, else female)
# VIRGO_VOICE_FR=fr-FR-HenriNeural   # pick one language's voice by hand (VIRGO_VOICE_<LANG>)
# VIRGO_KHMER_RATE=+0%        # e.g. -10% slower, +5% faster
# VIRGO_KHMER_PITCH=+0Hz       # e.g. -4Hz lower, +4Hz higher
# AZURE_SPEECH_KEY=...        # official Azure (commercial use); without it edge-tts is used (unofficial)
# AZURE_SPEECH_REGION=southeastasia
# VIRGO_PORT=8088         # the port on this machine (Cloudflare Tunnel route: http://127.0.0.1:8088)
